@using FlowerBloomStore.Domain.Entities.OrderModules
@using FlowerBloomStore.Domain.Enums
@model Order

@{
    ViewData["Title"] = $"تفاصيل الطلب رقم #{Model?.Id ?? 0}";
    Layout = "_AdminLayout";


    string GetStatusClasses(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "bg-yellow-100 text-yellow-800 border-yellow-200",
        OrderStatus.Processing => "bg-blue-100 text-blue-800 border-blue-200",
        OrderStatus.Delivered => "bg-green-100 text-green-800 border-green-200",
        OrderStatus.Cancelled => "bg-red-100 text-red-800 border-red-200",
        _ => "bg-gray-100 text-gray-800 border-gray-200"
    };
}

<header style="background-color: hsla(40, 20%, 98.5%, 1)" class="w-full border-b border-gray-200/60">
    <div style="padding: 1rem 2rem;" class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4">
        <div>
            <h1 style="color: color-mix(in oklab, #000 90%, transparent)" class="text-2xl font-semibold flex items-center gap-2">
                <iconify-icon icon="lucide:shopping-bag" class="text-[#2D5F3F]"></iconify-icon>
                تفاصيل الطلب <span class="text-[#2D5F3F]">#@Model?.Id</span>
            </h1>
        </div>
      
        <a href="@Url.Action("Index", "Order", new { area = "Admin" })" 
           class="hover:bg-[#2D5F3F]/5 border border-solid rounded-lg px-4 py-2 text-sm font-medium transition-colors inline-flex items-center gap-2"
           style="background-color: rgba(255, 255, 255, 1); color: rgba(45, 95, 63, 1); border-color: color-mix(in oklab, #2d5f3f 20%, transparent);">
            <iconify-icon icon="lucide:arrow-right" class="text-lg"></iconify-icon>
            العودة للقائمة
        </a>
    </div>
</header>

<main class="grow shrink w-full p-4 md:p-6 bg-gray-50/50" style="flex-basis: 0%">
    @if (Model == null)
    {
        <div class="bg-red-50 border border-red-200 rounded-2xl p-8 text-center">
            <iconify-icon icon="lucide:alert-circle" class="text-5xl text-red-400 mb-4"></iconify-icon>
            <h3 class="text-xl font-bold text-red-700 mb-2">الطلب غير موجود</h3>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-6">
            <div style="background-color: rgba(255, 255, 255, 1); box-shadow: 0 2px 8px rgba(45, 95, 63, 0.04);" class="rounded-2xl p-5 border border-gray-100/80 transition-all hover:shadow-md">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-gray-400 text-xs font-bold uppercase mb-1">حالة الطلب</p>
                        <span class="px-3 py-1.5 rounded-full text-sm font-bold inline-block @GetStatusClasses(Model.Status)">
                            @Model.Status
                        </span>
                    </div>
                    <div class="w-10 h-10 rounded-full bg-[#2D5F3F]/10 flex items-center justify-center">
                        <iconify-icon icon="lucide:package" class="text-[#2D5F3F] text-xl"></iconify-icon>
                    </div>
                </div>
                <div class="mt-3 pt-3 border-t border-gray-100 text-xs text-gray-500">تاريخ الطلب: <span class="font-medium text-gray-800">@Model.OrderDate.ToString("dd MMMM yyyy")</span></div>
            </div>

            <div style="background-color: rgba(255, 255, 255, 1); box-shadow: 0 2px 8px rgba(45, 95, 63, 0.04);" class="rounded-2xl p-5 border border-gray-100/80 transition-all hover:shadow-md">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-gray-400 text-xs font-bold uppercase mb-1">العميل</p>
                        <p class="font-bold text-gray-800">@(Model.User?.FullName ?? "عميل مجهول")</p>
                        <p class="text-sm text-gray-500 truncate max-w-[150px]">@(Model.User?.Email)</p>
                    </div>
                    <div class="w-10 h-10 rounded-full bg-[#2D5F3F]/10 flex items-center justify-center">
                        <iconify-icon icon="lucide:user" class="text-[#2D5F3F] text-xl"></iconify-icon>
                    </div>
                </div>
            </div>

            <div style="background-color: rgba(255, 255, 255, 1); box-shadow: 0 2px 8px rgba(45, 95, 63, 0.04);" class="rounded-2xl p-5 border border-gray-100/80 transition-all hover:shadow-md lg:col-span-2">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-gray-400 text-xs font-bold uppercase mb-1">إجمالي المبلغ</p>
                        <p class="text-3xl font-black text-[#2D5F3F]">@Model.TotalAmount.ToString("C")</p>
                    </div>
                    <div class="w-12 h-12 rounded-full bg-[#2D5F3F]/10 flex items-center justify-center text-[#2D5F3F]">
                        <iconify-icon icon="lucide:credit-card" class="text-2xl"></iconify-icon>
                    </div>
                </div>
            </div>
        </div>

        <div style="background-color: rgba(255, 255, 255, 1); box-shadow: 0 2px 8px rgba(45, 95, 63, 0.04);" class="rounded-2xl border border-gray-100/80 overflow-hidden mb-6">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50 flex items-center gap-2">
                <iconify-icon icon="lucide:shopping-cart" class="text-[#2D5F3F]"></iconify-icon>
                <h3 class="font-semibold text-gray-700">المنتجات المطلوبة</h3>
            </div>
            
            <div class="overflow-x-auto">
                <table class="w-full text-right min-w-[600px]">
                    <thead>
                        <tr class="bg-gray-50/80 text-gray-400 text-xs uppercase">
                            <th class="p-4 font-medium">المنتج</th>
                            <th class="p-4 text-center">الكمية</th>
                            <th class="p-4">السعر</th>
                            <th class="p-4">المجموع</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-gray-50/30 transition-colors">
                                <td class="p-4">
                                    <div class="flex items-center gap-3">
                                    
                                        <img src="@(string.IsNullOrEmpty(item.Product?.ImageUrl) ? Url.Content("~/images/default-product.png") : Url.Content(item.Product.ImageUrl))" 
                                             class="w-12 h-12 rounded-lg object-cover border border-gray-200"
                                             onerror="this.src='@Url.Content("~/images/default-product.png")'" />
                                        <span class="font-medium text-gray-800">@(item.Product?.Name ?? "منتج محذوف")</span>
                                    </div>
                                </td>
                                <td class="p-4 text-center text-gray-600 font-bold">@item.Quantity</td>
                                <td class="p-4 text-gray-600">@item.UnitPrice.ToString("C")</td>
                                <td class="p-4 font-bold text-[#2D5F3F]">@((item.Quantity * item.UnitPrice).ToString("C"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div style="background-color: rgba(255, 255, 255, 1); box-shadow: 0 2px 8px rgba(45, 95, 63, 0.04);" class="rounded-2xl p-6 border border-gray-100/80">
            <div class="flex flex-wrap items-center gap-4">
                <span class="text-sm font-bold text-gray-400 flex items-center gap-1">
                    <iconify-icon icon="lucide:settings" class="text-lg"></iconify-icon>
                    تحديث حالة الطلب:
                </span>

              
                <form action="@Url.Action("UpdateStatus", "Order", new { area = "Admin" })" method="post" 
                      onsubmit="return confirm('هل أنت متأكد من تغيير حالة الطلب؟');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="Processing" />
                    <button type="submit" 
                            class="px-5 py-2.5 bg-blue-50 text-blue-700 rounded-xl font-medium hover:bg-blue-600 hover:text-white transition-all flex items-center gap-2 border border-blue-200 hover:border-blue-600 disabled:opacity-50 disabled:cursor-not-allowed"
                            @(Model.Status == OrderStatus.Processing ? "disabled" : "")>
                        <iconify-icon icon="lucide:settings-2"></iconify-icon> تجهيز
                    </button>
                </form>

          
                <form action="@Url.Action("UpdateStatus", "Order", new { area = "Admin" })" method="post"
                      onsubmit="return confirm('هل أنت متأكد؟');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="Delivered" />
                    <button type="submit" 
                            class="px-5 py-2.5 bg-[#2D5F3F] text-white rounded-xl font-medium hover:bg-[#1E4229] transition-all flex items-center gap-2 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed"
                            @(Model.Status == OrderStatus.Delivered ? "disabled" : "")>
                        <iconify-icon icon="lucide:check-circle"></iconify-icon> تم التسليم
                    </button>
                </form>

               
                <form action="@Url.Action("UpdateStatus", "Order", new { area = "Admin" })" method="post"
                      onsubmit="return confirm('هل أنت متأكد من إلغاء الطلب؟');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="Cancelled" />
                    <button type="submit" 
                            class="px-5 py-2.5 bg-red-50 text-red-700 rounded-xl font-medium hover:bg-red-600 hover:text-white transition-all flex items-center gap-2 border border-red-200 hover:border-red-600 disabled:opacity-50 disabled:cursor-not-allowed"
                            @(Model.Status == OrderStatus.Cancelled ? "disabled" : "")>
                        <iconify-icon icon="lucide:x-circle"></iconify-icon> إلغاء الطلب
                    </button>
                </form>
            </div>
        </div>
    }
</main>