@using FlowerBloomStore.Domain.Entities.UsersModule
@using Microsoft.AspNetCore.Identity
@using FlowerBloomStore.Web.Models
@inject UserManager<ApplicationUser> UserManager

@{
    string displayName = User.Identity.Name ?? "زائر";
    string profilePicture = "/assets/images/default-avatar.png"; // رابط الصورة الافتراضي
    var currentUser = await UserManager.GetUserAsync(User);

    
    if (User.Identity.IsAuthenticated)
    {
        displayName = currentUser?.FullName ?? currentUser?.UserName ?? User.Identity.Name;
        profilePicture = currentUser?.ProfilePicture ?? "/assets/images/default-avatar.png";
        
    }
    

}




<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <title>Flora</title>
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
    <!-- Font Awesome icons (free version)-->
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <!-- Google fonts-->
    <link href="https://fonts.googleapis.com/css?family=Varela+Round" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet" />
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="/css/styles.css" rel="stylesheet" />
    <link href="/css/site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!--iconify-icon version: 3.0.0-->
    <script src="https://static.paraflowcontent.com/public/js/iconify/iconify-icon-3.0.0.js"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <link rel="icon" type="image/x-icon" href="~/assets/images/iconLogo.png" />
     <style>
     /* تنسيق صورة البروفايل */
     .profile-link {
         text-decoration: none;
         margin-left: 15px;
         transition: all 0.3s ease;
     }

     .profile-avatar {
         width: 40px;
         height: 40px;
         border-radius: 50%;
         overflow: hidden;
         border: 2px solid var(--primary-green, #2d5a27);
         transition: all 0.3s ease;
         cursor: pointer;
     }

         .profile-avatar:hover {
             transform: scale(1.1);
             border-color: var(--primary-rose, #d44e6c);
             box-shadow: 0 0 10px rgba(212, 78, 108, 0.3);
         }

         .profile-avatar img {
             width: 100%;
             height: 100%;
             object-fit: cover;
         }

     .avatar-placeholder {
         width: 100%;
         height: 100%;
         background: linear-gradient(145deg, var(--primary-green), var(--secondary-green));
         display: flex;
         align-items: center;
         justify-content: center;
         color: white;
         font-size: 1.2rem;
     }

     /* تحديث تنسيق الأزرار */
     .register-link {
         color: var(--primary-green, #2d5a27);
         text-decoration: none;
         font-weight: 600;
         margin-left: 15px;
         padding: 8px 15px;
         border-radius: 25px;
         transition: all 0.3s ease;
         display: inline-flex;
         align-items: center;
         gap: 5px;
     }

         .register-link:hover {
             color: var(--primary-rose, #d44e6c);
             background: rgba(212, 78, 108, 0.1);
         }

     .login-btn {
         background: linear-gradient(145deg, var(--primary-rose, #d44e6c), #e45f7c);
         color: white;
         border: none;
         padding: 8px 20px;
         border-radius: 25px;
         font-weight: 600;
         cursor: pointer;
         transition: all 0.3s ease;
         display: inline-flex;
         align-items: center;
         gap: 5px;
         margin-left: 10px;
     }

         .login-btn:hover {
             transform: translateY(-2px);
             box-shadow: 0 5px 15px rgba(212, 78, 108, 0.4);
         }

     /* تنسيق الـ nav-right */
     .nav-right {
         display: flex;
         align-items: center;
         gap: 10px;
     }

     /* للشاشات الصغيرة */
     @@media (max-width: 768px) {
         .profile-link {
             margin-left: 0;
         }

         .profile-avatar {
             width: 35px;
             height: 35px;
         }

         .register-link, .login-btn {
             padding: 6px 12px;
             font-size: 0.9rem;
         }
     }


     .profile-dropdown {
         position: relative;
         display: inline-block;
     }

     .dropdown-menu {
         display: none;
         position: absolute;
         left: 0;
         top: 50px;
         background: white;
         min-width: 220px;
         border-radius: 15px;
         box-shadow: 0 10px 30px rgba(0,0,0,0.15);
         z-index: 1000;
         overflow: hidden;
         animation: slideDown 0.3s ease;
     }

     .profile-dropdown:hover .dropdown-menu {
         display: block;
     }

     @@keyframes slideDown {
         from {
             opacity: 0;
             transform: translateY(-10px);
         }

         to {
             opacity: 1;
             transform: translateY(0);
         }
     }

     .dropdown-header {
         padding: 15px;
         background: linear-gradient(145deg, var(--light-green), #f0f7f0);
     }

     .dropdown-name {
         display: block;
         font-weight: 700;
         color: var(--primary-green);
         margin-bottom: 3px;
     }

     .dropdown-email {
         display: block;
         font-size: 0.85rem;
         color: #666;
     }

     .dropdown-divider {
         height: 1px;
         background: #e8e8e8;
         margin: 5px 0;
     }

     .dropdown-item {
         display: flex;
         align-items: center;
         gap: 10px;
         padding: 12px 15px;
         color: #333;
         text-decoration: none;
         transition: all 0.3s ease;
         font-size: 0.95rem;
     }

         .dropdown-item i {
             width: 20px;
             color: var(--primary-rose);
         }

         .dropdown-item:hover {
             background: var(--light-green);
             color: var(--primary-green);
             padding-right: 20px;
         }

     .logout-item {
         width: 100%;
         border: none;
         background: none;
         cursor: pointer;
         font-size: 0.95rem;
         color: #dc3545;
     }

         .logout-item i {
             color: #dc3545;
         }

         .logout-item:hover {
             background: rgba(220, 53, 69, 0.1);
         }
 </style>
</head>
<body id="page-top" dir="rtl">
    <!-- Navigation-->
    <nav class="navbar ">
        <div class="nav-left">
            <!-- Logo -->
            <div class="logo">
              <a asp-action="Index" asp-controller="/Home">
              <img src="~/assets/images/logo.png" width="120px"/>
              </a> 
            </div>

            <!-- Links -->
            <ul class="nav-links">
                <li><a class="active" asp-action="Index" asp-controller="/Home">الرئيسية</a></li>
                <li><a asp-action="Index" asp-controller="/Product">المتجر</a></li>
                <li><a asp-action="Index" asp-controller="/Product">المناسبات</a></li>
                <li><a asp-action="Index" asp-controller="/About">من نحن</a></li>
                <li><a asp-action="Index" asp-controller="/Contact">اتصل بنا</a></li>



            </ul>
        </div>

        <!-- Right Side -->
        <div class="nav-right">


            @* <iconify-icon id="34:23"
                          orderindex="80"
                          style="color: color-mix(in oklab, #000 65%, transparent)"
                          icon="lucide:search"
                          class="text-base"></iconify-icon> *@
   @if (User.Identity.IsAuthenticated)
      {
            <div >
                <a asp-action="Index" asp-controller="Wishlist">
                    <div class="icon-btn badge">
                        <iconify-icon id="34:26"
                                      orderindex="80"
                                      style="color: color-mix(in oklab, #000 65%, transparent)"
                                      icon="lucide:heart"
                                      class="text-base"></iconify-icon>

                      
                             <span>
                                @currentUser.Wishlist.Items?.Count()
                             </span> 
                            
                         
                    </div>
                </a>
            </div>

            <div>
                <a asp-action="Index" asp-controller="Cart">
                    <div class="icon-btn badge">
                        <iconify-icon id="34:31"
                                      orderindex="80"
                                      style="color: color-mix(in oklab, #000 65%, transparent)"
                                      icon="lucide:shopping-cart"
                                      class="text-base"></iconify-icon>
                                @await Component.InvokeAsync("CartSummary")
                     </div>
                </a>
            </div>


           
                <div class="profile-dropdown">
                    <a href="@Url.Action("Profile", "Account")" class="profile-link" id="profileTrigger">
                        <div class="profile-avatar">
                            @if (!string.IsNullOrEmpty(profilePicture))
                            {
                                <img src="@profilePicture" alt="@displayName"/>
                            }
                            else
                            {
                                <div class="avatar-placeholder">
                                    <i class="fas fa-user"></i>
                                </div>
                            }
                        </div>
                    </a>

                    <!-- القائمة المنسدلة -->
                    <div class="dropdown-menu" id="profileMenu">
                        <div class="dropdown-header">
                            <span class="dropdown-name">@displayName</span>
                            <span class="dropdown-email">@User.Identity.Name</span>
                        </div>
                        <div class="dropdown-divider"></div>
                        <a href="@Url.Action("Profile", "Account")" class="dropdown-item">
                            <i class="fas fa-user-circle"></i> الملف الشخصي
                        </a>
                        <a href="@Url.Action("Orders", "Account")" class="dropdown-item">
                            <i class="fas fa-shopping-bag"></i> طلباتي
                        </a>
                        <a href="@Url.Action("Wishlist", "Account")" class="dropdown-item">
                            <i class="fas fa-heart"></i> المفضلة
                        </a>
                        <a href="@Url.Action("Settings", "Account")" class="dropdown-item">
                            <i class="fas fa-cog"></i> الإعدادات
                        </a>
                        <div class="dropdown-divider"></div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="dropdown-logout-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item logout-item">
                                <i class="fas fa-sign-out-alt"></i> تسجيل خروج
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <button onclick="window.location.href='@Url.Action("Login", "Account")'" class="login-btn">
                    <i class="fas fa-sign-in-alt"></i> تسجيل الدخول
                </button>
            }


            <!-- Mobile Menu Button -->
            <div class="menu-toggle" onclick="toggleMenu()">☰</div>
        </div>
    </nav>

    <main role="main" class="main ">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-grid">

                <!-- Column 1 -->
                <div class="footer-col col1">
                    <div class="footer-logo">
                        <i class="fa-solid fa-flower"></i>
                        <img src="./assets/images/logo.png" width="100px" />

                    </div>
                    <p>
                        متجرك المتخصص في أجمل الزهور والنباتات الطبيعية.
                        نقدم خدمات التوصيل السريع ونضمن جودة عالية في جميع منتجاتنا.
                    </p>
                </div>

                <!-- Column 2 -->
                <div class="footer-col">
                    <h3>روابط سريعة</h3>
                    <ul>
                        <li><a href="#">من نحن</a></li>
                        <li><a href="#">اتصل بنا</a></li>
                        <li><a href="#">سياسة الخصوصية</a></li>
                        <li><a href="#">شروط الاستخدام</a></li>
                        <li><a href="#">الأسئلة الشائعة</a></li>
                    </ul>
                </div>

                <!-- Column 3 -->
                <div class="footer-col">
                    <h3>معلومات التواصل</h3>
                    <p><i class="fa-solid fa-phone"></i> +966 50 123 4567</p>
                    <p><i class="fa-solid fa-envelope"></i> info@flora.sa</p>
                    <p><i class="fa-solid fa-location-dot"></i> الرياض، حي النخيل، شارع الملك فهد</p>
                </div>

                <!-- Column 4 -->
                <div class="footer-col">
                    <h3>تابعنا</h3>
                    <div class="social-icons">
                        <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#"><i class="fa-brands fa-twitter"></i></a>
                        <a href="#"><i class="fa-brands fa-whatsapp"></i></a>
                    </div>
                </div>

            </div>

            <div class="footer-bottom">
                <p>© 2026 Flora. جميع الحقوق محفوظة.</p>
            </div>
        </div>
    </footer>



    <!-- Bootstrap core JS-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Core theme JS-->
    <script src="/js/scripts.js"></script>
    <!-- * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *-->
    <!-- * *                               SB Forms JS                               * *-->
    <!-- * * Activate your form at https://startbootstrap.com/solution/contact-forms * *-->
    <!-- * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *-->
    <script src="https://cdn.startbootstrap.com/sb-forms-latest.js"></script>
   <script>
        function toggleMenu() {
          document.querySelector(".nav-links").classList.toggle("show");
          $(".nav-links").slideToggle(400)
        }
    </script>

   
    @if (TempData["Success"] != null)
    {
        <script>
            Toastify({
                text: "@TempData["Success"]",
                duration: 3000,
                gravity: "top",
                position: "right",
                backgroundColor: "#28a745"
            }).showToast();
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Toastify({
                text: "@TempData["Error"]",
                duration: 3000,
                gravity: "top",
                position: "right",
                backgroundColor: "#dc3545"
            }).showToast();
        </script>
    }
</body>
</html>
