@model FlowerBloomStore.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "تسجيل حساب جديد";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Flora</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-green: #2d5a27;
            --secondary-green: #4a7856;
            --light-green: #e8f3e8;
            --primary-rose: #d44e6c;
            --light-rose: #fce4e9;
            --soft-white: #fff9f9;
            --gold-accent: #c4a747;
            --leaf-shadow: rgba(45, 90, 39, 0.1);
            --soft-brown: #8b7355;
        }

        body {
            background: linear-gradient(135deg, var(--light-green) 0%, var(--soft-white) 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 20px;
            position: relative;
            overflow-x: hidden;
            height:100dvh;
        }

        .floating-elements {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            pointer-events: none;
            z-index: 0;
        }

        .float-element {
            position: absolute;
            opacity: 0.2;
            animation: float 20s infinite ease-in-out;
            color: var(--primary-green);
        }

        .element-1 {
            top: 5%;
            left: 5%;
            font-size: 4rem;
            animation-delay: 0s;
            color: var(--primary-rose);
            transform: rotate(-15deg);
        }

        .element-2 {
            bottom: 10%;
            right: 8%;
            font-size: 5rem;
            animation-delay: 4s;
            color: var(--gold-accent);
            transform: rotate(20deg);
        }

        .element-3 {
            top: 15%;
            right: 12%;
            font-size: 3.5rem;
            animation-delay: 2s;
            color: var(--primary-green);
            transform: rotate(45deg);
        }

        .element-4 {
            bottom: 20%;
            left: 7%;
            font-size: 4.5rem;
            animation-delay: 6s;
            color: var(--soft-brown);
            transform: rotate(-30deg);
        }

        .element-5 {
            top: 40%;
            left: 15%;
            font-size: 3rem;
            animation-delay: 8s;
            color: var(--primary-rose);
            transform: rotate(10deg);
        }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0) rotate(0deg);
            }

            25% {
                transform: translateY(-20px) rotate(5deg);
            }

            50% {
                transform: translateY(-30px) rotate(10deg);
            }

            75% {
                transform: translateY(-15px) rotate(5deg);
            }
        }

        /* تعديل العرض ليصبح أكبر */
        .register-wrapper {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 40px;
            box-shadow: 0 25px 50px var(--leaf-shadow), 0 0 0 2px rgba(255,255,255,0.8) inset;
            overflow: hidden;
            width: 100%;
            max-width: 700px; /* زيادة العرض من 550px إلى 1000px */
            position: relative;
            z-index: 1;
            animation: slideUpFade 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @@keyframes slideUpFade {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .register-header {
            background: linear-gradient(145deg, var(--primary-green), var(--secondary-green));
            padding: 35px 25px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .register-header::before {
                content: "✿";
                position: absolute;
                top: -20px;
                right: -20px;
                font-size: 150px;
                color: rgba(255, 255, 255, 0.1);
                transform: rotate(25deg);
                animation: rotateSlow 30s linear infinite;
            }

            .register-header::after {
                content: "❀";
                position: absolute;
                bottom: -40px;
                left: -20px;
                font-size: 180px;
                color: rgba(255, 255, 255, 0.08);
                transform: rotate(-15deg);
                animation: rotateSlow 25s linear infinite reverse;
            }

        @@keyframes rotateSlow {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .header-icon {
            font-size: 4rem;
            color: var(--gold-accent);
            margin-bottom: 15px;
            animation: petalDance 4s infinite ease-in-out;
            display: inline-block;
            position: relative;
            z-index: 2;
        }

        @@keyframes petalDance {
            0%, 100% {
                transform: scale(1) rotate(0deg);
            }

            33% {
                transform: scale(1.1) rotate(-5deg);
            }

            66% {
                transform: scale(1.1) rotate(5deg);
            }
        }

        .register-header h1 {
            color: white;
            font-size: 2.2rem;
            margin-bottom: 10px;
            position: relative;
            z-index: 2;
            text-shadow: 3px 3px 6px rgba(0,0,0,0.2);
            font-weight: 600;
        }

        .register-header p {
            color: rgba(255,255,255,0.95);
            font-size: 1.1rem;
            position: relative;
            z-index: 2;
            margin: 0;
        }

        .register-body {
            padding: 40px 35px;
            background: white;
        }

        /* تعديل شبكة الحقول لتصبح 3 أعمدة */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            position: relative;
            animation: fadeInStagger 0.5s ease-out forwards;
            opacity: 0;
            margin-bottom: 15px;
        }

            .form-group:nth-child(1) {
                animation-delay: 0.1s;
            }

            .form-group:nth-child(2) {
                animation-delay: 0.2s;
            }

            .form-group:nth-child(3) {
                animation-delay: 0.3s;
            }

            .form-group:nth-child(4) {
                animation-delay: 0.4s;
            }

            .form-group:nth-child(5) {
                animation-delay: 0.5s;
            }

            .form-group:nth-child(6) {
                animation-delay: 0.6s;
            }

        @@keyframes fadeInStagger {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--primary-green);
            font-weight: 600;
            font-size: 0.95rem;
        }

            .form-group label i {
                color: var(--primary-rose);
                margin-left: 6px;
                font-size: 0.95rem;
                transition: transform 0.3s ease;
            }

        .form-group:hover label i {
            transform: scale(1.2);
        }

        .input-wrapper {
            position: relative;
        }

            .input-wrapper i {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--primary-green);
                font-size: 1rem;
                transition: all 0.3s ease;
                z-index: 2;
            }

        .form-control {
            width: 100%;
            padding: 12px 35px 12px 15px;
            border: 2px solid #e8e8e8;
            border-radius: 25px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background: white;
        }

            .form-control:focus {
                outline: none;
                border-color: var(--primary-rose);
                box-shadow: 0 0 0 3px rgba(212, 78, 108, 0.1);
                transform: translateY(-2px);
            }

            .form-control:hover:not(:focus) {
                border-color: var(--primary-green);
                background: #fafafa;
            }

        /* تعديل قسم الأدوار */
        .role-section {
            background: var(--light-green);
            padding: 25px;
            border-radius: 30px;
            margin: 25px 0;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(45, 90, 39, 0.2);
            }

            50% {
                box-shadow: 0 0 0 10px rgba(45, 90, 39, 0);
            }
        }

        .role-section label {
            color: var(--primary-green);
            font-size: 1.1rem;
            margin-bottom: 20px;
            display: block;
        }

        .role-options {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .role-option {
            min-width: auto;
        }

            .role-option input[type="radio"] {
                display: none;
            }

            .role-option .role-label {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                padding: 15px 20px;
                background: white;
                border: 2px solid #e0e0e0;
                border-radius: 50px;
                cursor: pointer;
                transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
                font-weight: 600;
            }

                .role-option .role-label i {
                    font-size: 1.2rem;
                    color: #666;
                    transition: all 0.3s ease;
                }

            .role-option input[type="radio"]:checked + .role-label {
                background: linear-gradient(145deg, var(--primary-rose), #e45f7c);
                border-color: var(--primary-rose);
                color: white;
                transform: scale(1.02);
                box-shadow: 0 10px 20px rgba(212, 78, 108, 0.3);
            }

                .role-option input[type="radio"]:checked + .role-label i {
                    color: white;
                }

            .role-option:hover .role-label {
                border-color: var(--primary-rose);
                transform: translateY(-2px);
            }

        .password-strength {
            height: 4px;
            background: #e0e0e0;
            border-radius: 2px;
            margin-top: 8px;
            overflow: hidden;
        }

        .password-strength-bar {
            height: 100%;
            width: 0;
            transition: all 0.5s ease;
            border-radius: 2px;
        }

            .password-strength-bar.weak {
                width: 33.33%;
                background: linear-gradient(90deg, #dc3545, #ff6b6b);
            }

            .password-strength-bar.medium {
                width: 66.66%;
                background: linear-gradient(90deg, #ffc107, #ffdb6b);
            }

            .password-strength-bar.strong {
                width: 100%;
                background: linear-gradient(90deg, #28a745, #6fcf97);
            }

        /* تعديل الأزرار */
        .button-container {
            display: flex;
            gap: 20px;
            margin-top: 30px;
        }

        .btn-register {
            flex: 2;
            padding: 16px 30px;
            background: linear-gradient(145deg, var(--primary-green), var(--secondary-green));
            color: white;
            border: none;
            border-radius: 50px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

            .btn-register::before {
                content: "";
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0;
                height: 0;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.3);
                transform: translate(-50%, -50%);
                transition: width 0.6s, height 0.6s;
            }

            .btn-register:hover::before {
                width: 300px;
                height: 300px;
            }

            .btn-register:hover {
                transform: translateY(-3px);
                box-shadow: 0 15px 30px rgba(45, 90, 39, 0.4);
            }

            .btn-register i {
                font-size: 1.2rem;
                animation: bounce 2s infinite;
            }

        @@keyframes bounce {
            0%, 100% {
                transform: translateX(0);
            }

            50% {
                transform: translateX(5px);
            }
        }

        .btn-login {
            flex: 1;
            padding: 16px 30px;
            background: white;
            color: var(--primary-rose);
            border: 2px solid var(--primary-rose);
            border-radius: 50px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.4s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-decoration: none;
        }

            .btn-login:hover {
                background: var(--light-rose);
                transform: translateY(-3px);
                box-shadow: 0 10px 20px rgba(212, 78, 108, 0.2);
            }

            .btn-login i {
                font-size: 1.2rem;
            }

        /* إزالة القسم القديم */
        .login-link {
            display: none;
        }

        .validation-summary-errors {
            background: rgba(220, 53, 69, 0.1);
            border-right: 4px solid #dc3545;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 25px;
            animation: slideInRight 0.5s ease;
        }

        @@keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(30px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .field-validation-error {
            color: #dc3545;
            font-size: 0.8rem;
            margin-top: 5px;
            display: block;
            padding-right: 10px;
            animation: shake 0.5s ease;
        }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-5px);
            }

            75% {
                transform: translateX(5px);
            }
        }

        .text-success {
            color: #28a745;
            background: rgba(40, 167, 69, 0.1);
            padding: 15px;
            border-radius: 10px;
            border-right: 4px solid #28a745;
            margin-bottom: 25px;
            animation: slideDown 0.5s ease;
        }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .ripple {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.5);
            transform: scale(0);
            animation: ripple-animation 0.6s ease-out;
            pointer-events: none;
        }

        @@keyframes ripple-animation {
            to {
                transform: scale(4);
                opacity: 0;
            }
        }

        /* Responsive */
        @@media (min-width: 768px) {
            .register-wrapper {
                transform: scale(.75);
            }
        }
        @@media (max-width: 768px) {
            body{
                height:auto;
            }
            .form-grid {
                grid-template-columns: 1fr;
            }

            .role-options {
                grid-template-columns: 1fr;
            }

            .button-container {
                flex-direction: column;
            }

            .register-wrapper {
                max-width: 95%;
            }
            .register-header{
                display:none;
            }
            .login-hero{
                display:none;
            }
        }
    </style>
</head>
<body>
    <div class="floating-elements">
        <i class="fas fa-seedling float-element element-1"></i>
        <i class="fas fa-leaf float-element element-2"></i>
        <i class="fas fa-tree float-element element-3"></i>
        <i class="fas fa-pagelines float-element element-4"></i>
        <i class="fas fa-flower float-element element-5"></i>
    </div>

    <div class="register-wrapper">
        <div class="register-header">
            <div class="header-icon">
                <i class="fas fa-seedling"></i>
            </div>
            <h1>انضم إلى عائلة Flora</h1>
            <p>سجل الآن واستمتع بتجربة الزهور الفريدة</p>
        </div>

        <div class="register-body">
            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { id = "registerForm" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                if (TempData["SuccessMessage"] != null)
                {
                    <div class="text-success">
                        <i class="fas fa-check-circle"></i>
                        @TempData["SuccessMessage"]
                    </div>
                }

                <!-- شبكة الحقول - 3 أعمدة -->
                <div class="form-grid">
                    <!-- Full Name -->
                    <div class="form-group">
                        @Html.LabelFor(m => m.FullName, new { @class = "control-label" })
                        <div class="input-wrapper">
                            <i class="fas fa-pen"></i>
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "أدخل اسمك الكامل" })
                        </div>
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "field-validation-error" })
                    </div>

                    <!-- Email -->
                    <div class="form-group">
                        @Html.LabelFor(m => m.Email, new { @class = "control-label" })
                        <div class="input-wrapper">
                            <i class="fas fa-at"></i>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "example@domain.com" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
                    </div>

                    <!-- Phone Number -->
                    <div class="form-group">
                        @Html.LabelFor(m => m.PhoneNumber, new { @class = "control-label" })
                        <div class="input-wrapper">
                            <i class="fas fa-mobile-alt"></i>
                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "05xxxxxxxx" })
                        </div>
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "field-validation-error" })
                    </div>

                    <!-- Password -->
                    <div class="form-group">
                        @Html.LabelFor(m => m.Password, new { @class = "control-label" })
                        <div class="input-wrapper">
                            <i class="fas fa-key"></i>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "********", id = "password" })
                        </div>
                        <div class="password-strength">
                            <div class="password-strength-bar" id="passwordStrength"></div>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                    </div>

                    <!-- Confirm Password -->
                    <div class="form-group">
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "control-label" })
                        <div class="input-wrapper">
                            <i class="fas fa-check-circle"></i>
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "********" })
                        </div>
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-validation-error" })
                    </div>

                    <!-- حقل فارغ للمحاذاة (اختياري) -->
                    <div class="form-group">
                        <!-- يمكن ترك هذا فارغاً أو إضافة حقل آخر -->
                    </div>
                </div>

                <!-- Role Selection -->
                <div class="role-section">
                    <label>
                        <i class="fas fa-user-tag"></i>
                        نوع الحساب
                    </label>
                    <div class="role-options">
                        <div class="role-option">
                            <input type="radio" name="Role" id="roleCustomer" value="Customer" checked />
                            <label for="roleCustomer" class="role-label">
                                <i class="fas fa-user"></i>
                                عميل
                            </label>
                        </div>
                        <div class="role-option">
                            <input type="radio" name="Role" id="roleAdmin" value="Admin" />
                            <label for="roleAdmin" class="role-label">
                                <i class="fas fa-user-cog"></i>
                                مسؤول
                            </label>
                        </div>
                        <div class="role-option">
                            <input type="radio" name="Role" id="roleVendor" value="Vendor" />
                            <label for="roleVendor" class="role-label">
                                <i class="fas fa-store"></i>
                                بائع
                            </label>
                        </div>
                    </div>
                </div>

                <!-- أزرار التحكم -->
                <div class="button-container">
                    <button type="submit" class="btn-register">
                        <i class="fas fa-flower"></i>
                        تسجيل حساب جديد
                        <i class="fas fa-arrow-left"></i>
                    </button>

                    <a href="@Url.Action("Login", "Account")" class="btn-login">
                        <i class="fas fa-sign-in-alt"></i>
                        تسجيل الدخول
                    </a>
                </div>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        // Password strength indicator
        const password = document.getElementById('password');
        const strengthBar = document.getElementById('passwordStrength');

        if (password) {
            password.addEventListener('input', function() {
                const value = this.value;
                let strength = 'weak';

                if (value.length >= 8) {
                    strength = 'medium';
                }
                if (value.length >= 12 && /[A-Z]/.test(value) && /[0-9]/.test(value) && /[^A-Za-z0-9]/.test(value)) {
                    strength = 'strong';
                }

                strengthBar.className = 'password-strength-bar ' + strength;
            });
        }

        // Form submission with loading state
        document.getElementById('registerForm').addEventListener('submit', function(e) {
            const btn = document.querySelector('.btn-register');
            if (btn && btn.disabled !== true) {
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري إنشاء الحساب...';
                btn.disabled = true;
            }
        });

        // Auto-hide validation messages
        setTimeout(function() {
            document.querySelectorAll('.field-validation-error').forEach(el => {
                if (el.innerHTML.trim() !== '') {
                    el.style.transition = 'opacity 0.5s';
                    el.style.opacity = '0';
                }
            });
        }, 5000);

        // Add floating effect to icons on focus
        document.querySelectorAll('.form-control').forEach(input => {
            input.addEventListener('focus', function() {
                const icon = this.previousElementSibling;
                if (icon && icon.classList.contains('fa')) {
                    icon.style.transform = 'translateY(-50%) scale(1.2)';
                    icon.style.color = 'var(--primary-rose)';
                }
            });

            input.addEventListener('blur', function() {
                const icon = this.previousElementSibling;
                if (icon && icon.classList.contains('fa')) {
                    icon.style.transform = 'translateY(-50%) scale(1)';
                    icon.style.color = 'var(--primary-green)';
                }
            });
        });

        // Role selection animation
        document.querySelectorAll('.role-option input[type="radio"]').forEach(radio => {
            radio.addEventListener('change', function() {
                if (this.checked) {
                    const label = this.nextElementSibling;
                    label.style.animation = 'pulse 0.5s';
                    setTimeout(() => {
                        label.style.animation = '';
                    }, 500);
                }
            });
        });

        // Add ripple effect to submit button
        document.querySelector('.btn-register').addEventListener('click', function(e) {
            const ripple = document.createElement('span');
            ripple.classList.add('ripple');
            this.appendChild(ripple);

            const x = e.clientX - e.target.offsetLeft;
            const y = e.clientY - e.target.offsetTop;

            ripple.style.left = x + 'px';
            ripple.style.top = y + 'px';

            setTimeout(() => {
                ripple.remove();
            }, 600);
        });
    </script>
</body>
</html>