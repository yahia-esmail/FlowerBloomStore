    <div style="color: color-mix(in oklab, #000 65%, transparent);" class="text-sm d-flex align-items-center gap-2">
        <a class="text-decoration-none hover-text-[#2D5F3F]" href="/">الرئيسية</a>
        <iconify-icon icon="lucide:chevron-left" class="text-xs"></iconify-icon>
        <a class="text-decoration-none hover-text-[#2D5F3F]" href="/Product">المتجر</a>
        <iconify-icon icon="lucide:chevron-left" class="text-xs"></iconify-icon>
        <span style="color: rgba(45, 95, 63, 1);">@Model.Name</span>
